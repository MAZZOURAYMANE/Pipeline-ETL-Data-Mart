<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiche_crui_wizard_form" model="ir.ui.view">
        <field name="name">fiche.crui.wizard.form</field>
        <field name="model">fiche.crui.wizard</field>
        <field name="arch" type="xml">
            <form string="Générer la fiche CRUI">
                <sheet>
                    <group>
                        <group>
                            <field name="date_passage" required="1"/>
                        </group>
                    </group>
                    <group invisible="not file_data">
                        <group>
                            <field name="file_data" filename="file_name" readonly="1"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_fiche_crui"
                            string="Générer la fiche CRUI"
                            type="object"
                            class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fiche_crui_wizard" model="ir.actions.act_window">
        <field name="name">Fiche CRUI</field>
        <field name="res_model">fiche.crui.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_fiche_crui_wizard"
              name="Fiche CRUI"
              parent="menu_reports"
              action="action_fiche_crui_wizard"
              sequence="15"/>
</odoo>
