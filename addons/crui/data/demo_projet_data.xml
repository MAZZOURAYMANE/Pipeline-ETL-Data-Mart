        </record>

        <!-- Actes CRUI -->
        <record id="act_accord_principe" model="act">
            <field name="name">Accord de principe CRUI</field>
        </record>
        <record id="act_permis_construire" model="act">
            <field name="name">Autorisation de construire</field>
        </record>
        <record id="act_derogation" model="act">
            <field name="name">Dérogation urbanistique</field>
        </record>
        <record id="act_attribution_lot" model="act">
