        <!-- 4. DOSSIERS, SOUMISSIONS & ENQUÊTES ASSOCIÉS             -->
        <!-- ========================================================= -->

        <!-- Dossier lié au Projet 1 -->
        <record id="dossier_demo_1" model="dossier">
            <field name="name">Dossier d'instruction CRUI - Unité Emballages</field>
            <field name="projet_id" ref="projet_demo_1"/>
            <field name="reference">DOS-2024-FES-001</field>
            <field name="statut_dossier">crui</field>
            <field name="state">en cours</field>
            <field name="etat_procedure">Programmée</field>
            <field name="actes_ids" eval="[(6, 0, [ref('act_permis_construire'), ref('act_accord_principe')])]"/>
            <field name="date_depot" eval="(DateTime.today() - relativedelta(days=20)).strftime('%Y-%m-%d 10:00:00')"/>
            <field name="date_retour_spoc" eval="(DateTime.today() - relativedelta(days=12)).strftime('%Y-%m-%d 15:30:00')"/>
