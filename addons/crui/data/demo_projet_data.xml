            <field name="name">Réalisation d'un Éco-Resort touristique &amp; Spa 4 étoiles</field>
            <field name="identifiant_projet">PRJ-2024-IFR-004</field>
            <field name="reference">CRUI/IFR/2024/0032</field>
            <field name="statut">traitement spoc</field>
