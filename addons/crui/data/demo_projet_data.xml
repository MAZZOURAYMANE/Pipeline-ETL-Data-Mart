            <field name="forme_juridique">Société anonyme (SA)</field>
            <field name="prefecture_id" ref="pref_ifrane"/>
            <field name="commune_id" ref="commune_ifrane"/>
            <field name="macro_secteurs" eval="[(6, 0, [ref('macro_tourisme')])]"/>
            <field name="secteurs" eval="[(6, 0, [ref('secteur_hotellerie')])]"/>
            <field name="fonciers" eval="[(6, 0, [ref('foncier_melk')])]"/>
