            <field name="etat_avancement">Travaux achevés activité démarrée</field>
            <field name="pourcentage_realisation">100.0</field>
            <field name="montant_investissement_reel">32500000.00</field>
            <field name="nombre_emplois_reel">360</field>
            <field name="date_autorisation" eval="(DateTime.today() - relativedelta(months=11)).strftime('%Y-%m-%d 10:00:00')"/>
