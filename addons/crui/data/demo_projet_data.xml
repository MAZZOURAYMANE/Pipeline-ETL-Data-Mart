        <!-- PROJET 1 : En Traitement CRUI (Industrie à Fès) -->
        <record id="projet_demo_1" model="projet">
            <field name="name">Construction d'une unité de fabrication d'emballages biodégradables</field>
            <field name="identifiant_projet">PRJ-2024-FES-001</field>
            <field name="reference">CRUI/FES/2024/0148</field>
            <field name="statut">traitement crui</field>
            <field name="petitionnaire_id" ref="partner_atlas_packaging"/>
            <field name="raison_social">Atlas Packaging SARL</field>
            <field name="forme_juridique">Société à Responsabilité Limitée (SARL)</field>
            <field name="prefecture_id" ref="pref_fes"/>
            <field name="commune_id" ref="commune_fes_agdal"/>
            <field name="macro_secteurs" eval="[(6, 0, [ref('macro_industrie')])]"/>
            <field name="secteurs" eval="[(6, 0, [ref('secteur_emballage')])]"/>
            <field name="fonciers" eval="[(6, 0, [ref('foncier_zi')])]"/>
            <field name="surface">15 400 m²</field>
            <field name="reference_fonciere">Titre Foncier N° 45892/05 - Lot ZI-45</field>
            <field name="montant_investissement">55000000.00000</field>
            <field name="nombre_emploi">135</field>
            <field name="composante_dominante">Unité de production automatisée &amp; stockage</field>
            <field name="montant_investissement_composante_dominante">42000000.00000</field>
            <field name="nombre_emploi_composante_dominante">95</field>
            <field name="consistance">Projet industriel composé de 2 unités de production, un bâtiment administratif R+2, un laboratoire R&amp;D qualité et une plateforme de stockage logistique couverte de 4 000 m².</field>
            <field name="composante">Hangar de production (6 000 m²), Stockage matières premières (4 000 m²), Bureaux administratifs (800 m²), Espace technique &amp; voirie (4 600 m²).</field>
            <field name="dispositions_urbanistiques">Zone Industrielle (ZAE), COS: 0.60, Hauteur maximale autorisée: 14m (R+2), Retrait voirie: 5m.</field>
            <field name="historique_projet">Dépôt du dossier initial via le portail CRI-Invest le 12/01/2024. Avis favorable des services techniques le 28/01/2024. Programmé pour la commission CRUI du 15/02/2024.</field>
            <field name="date_lancement" eval="(DateTime.today() - relativedelta(months=1)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="date_achevement" eval="(DateTime.today() + relativedelta(months=18)).strftime('%Y-%m-%d 18:00:00')"/>
        </record>

        <!-- PROJET 2 : Traitement SPOC (Tourisme & Hôtellerie à Ifrane) -->
