            <field name="dispositions_urbanistiques">Zone Touristique Protégée (ZT3), COS: 0.20, Emprise au sol max: 15%, Intégration paysagère et toiture en tuile verte obligatoire.</field>
            <field name="historique_projet">Demande soumise le 04/02/2024. Étude d'impact environnemental déposée et en cours de validation par le SPOC territorial.</field>
            <field name="date_lancement" eval="(DateTime.today() + relativedelta(months=2)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="date_achevement" eval="(DateTime.today() + relativedelta(months=24)).strftime('%Y-%m-%d 18:00:00')"/>
        </record>

