<odoo>
    <data>
        <record model="ir.ui.view" id="crui_visite_list_view">
            <field name="name">visite.list</field>
            <field name="model">visite</field>
            <field name="arch" type="xml">
                <list>
                    <!-- Champ pour télécharger le fichier PDF -->
                    
                    <field name="id"/>
                    <field name="date_de_la_visite"/>
                    <field name="prise_de_connaissance"/>
                    <field name="localisation"/>
                    <field name="type_visite"/>
                    <field name="Objet" optional="show"/>
                    <field name="suite" optional="show"/>
                </list>
            </field>
        </record>
        <record model="ir.ui.view" id="visite_form_view">
            <field name="name">visite.form</field>
            <field name="model">visite</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group string="Données visite">
                                <field name="date_de_la_visite"></field>
                                <field name="prise_de_connaissance"/>
                                <field name="localisation"/>
                                <field name="Objet"/>
                                <field name="suite"/>
                                <field name="prefecture_id"/>
                                <field name="secteur" widget="many2many_tags"/>
                                <field name="employe_id"/>
                                <field name="department_id"/>
                            </group>
                            <group string="Données Visiteur">
                                <group>
                                    <field name="investisseur_id"></field>
                                    <field name="investisseur"></field>
                                    <field name="telephone"/>
                                </group>
                                <group>
                                    <field name="civilite"/>
                                    <field name="email"></field>
                                    <field name="adresse"></field>
                                </group>
                            </group>
                        </group>
                    </sheet>
                </form>

            </field>
        </record>
        <record model="ir.actions.act_window" id="action_visite">
            <field name="name">Visite</field>
            <field name="res_model">visite</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>